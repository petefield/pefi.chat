@namespace PefiChat.Client
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject ILogger<ChatRoom> Logger
@inject Microsoft.JSInterop.IJSRuntime JS
@using Microsoft.AspNetCore.Components.Forms

<div class="chat-app">
    <header class="topbar">
        <div class="brand">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M5 6.5h14v9H11l-4 3v-3H5v-9Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M8.5 10.9h7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
            </span>
            <div><h1>Pefi Chat</h1><p class="brand-subtitle">A little space to connect</p></div>
        </div>
        <div class="account">
            @if (user is not null)
            {
            <div class="identity">
                @if (user.Picture is not null)
                {
                    <img class="avatar" src="@PictureUrl(user.Picture)" alt="" />
                }
                else
                {
                    <span class="avatar" aria-hidden="true">@Initial(user.Name)</span>
                }
                <div><strong>@user.Name</strong><small>Signed in</small></div>
            </div>
            <button type="button" class="secondary" @onclick="OpenProfile">Edit profile</button>
            <button type="button" class="secondary" @onclick="EnablePushAsync" disabled="@enablingPush">Enable notifications</button>
            }
            <form action="/logout" method="post">
                <input type="hidden" name="__RequestVerificationToken" value="@LogoutToken" />
                <button class="secondary" type="submit">Sign out</button>
            </form>
        </div>
    </header>
@if (user is not null)
{
    @if (editingProfile)
    {
        <section class="profile-editor" aria-label="Edit profile">
            <h2>Edit profile</h2>
            <p>Choose a unique username and optionally upload a picture.</p>
            <form @onsubmit="SaveProfileAsync" @onsubmit:preventDefault>
                <label for="username">Username</label>
                <input id="username" maxlength="@ChatLimits.MaximumUsernameLength" @bind="profileName" autocomplete="off" />
                <small>3–32 letters, numbers, underscores or hyphens.</small>
                <label for="profile-picture">Profile picture</label>
                <InputFile id="profile-picture" OnChange="SelectPictureAsync" accept="image/png,image/jpeg,image/webp,image/gif" />
                <small>Up to 512 KB. Images are cropped to a square.</small>
                @if (profileError is not null) { <p class="profile-error" role="alert">@profileError</p> }
                <div class="profile-actions">
                    <button type="submit" disabled="@(!connected || savingProfile)">Save profile</button>
                    <button type="button" class="secondary" @onclick="CloseProfile" disabled="@savingProfile">Cancel</button>
                </div>
            </form>
        </section>
    }
    <div class="chat-layout">
        <nav class="conversation-tabs" aria-label="Conversation types">
            <button type="button" class="conversation-tab @(!showDirectMessages ? "active" : "")"
                    aria-pressed="@(!showDirectMessages)" @onclick="() => SelectTabAsync(false)"><span class="tab-icon" aria-hidden="true">#</span> Rooms</button>
            <button type="button" class="conversation-tab @(showDirectMessages ? "active" : "")"
                    aria-pressed="@showDirectMessages" @onclick="() => SelectTabAsync(true)"><svg class="tab-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5h16v12H9l-5 3V5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M8 11h.01M12 11h.01M16 11h.01" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg> Direct messages</button>
        </nav>
        <aside class="sidebar">
            @if (!showDirectMessages)
            {
                <p class="section-label">Your rooms</p>
                <button type="button" class="conversation active" aria-current="true"
                        @onclick="() => SelectUserAsync(null, null)">
                    <span class="conversation-icon">#</span>
                    <span><strong>Everyone</strong><small>Shared room</small></span>
                </button>
            }
            else
            {
                <p class="section-label">People <span class="count">@users.Count</span></p>
                @if (users.Count == 0)
                {
                    <p class="empty-users">No other users have signed in yet.</p>
                }
                @foreach (var person in users)
                {
                    <button type="button" class="conversation @(selectedUserId == person.Id ? "active" : "")"
                            aria-current="@(selectedUserId == person.Id ? "true" : null)"
                            @onclick="() => SelectUserAsync(person.Id, person.Name)">
                        <span class="person-avatar-wrap">
                            @if (person.Picture is not null)
                            {
                                <img class="person-avatar" src="@PictureUrl(person.Picture)" alt="" />
                            }
                            else
                            {
                                <span class="person-avatar">@Initial(person.Name)</span>
                            }
                            <span class="online-dot @(!person.IsOnline ? "is-offline" : "")" aria-label="@(person.IsOnline ? "Online" : "Offline")"></span>
                        </span>
                        <span><strong>@person.Name</strong><small>@(person.IsOnline ? "Online" : "Offline")</small></span>
                    </button>
                }
            }
        </aside>
        <section class="chat-panel" aria-label="Chat conversation">
            @if (showDirectMessages && selectedUserId is null)
            {
                <div class="chat-heading">
                    <div>
                        <h2>Messages</h2>
                        <p class="heading-subtitle">Choose someone to start a conversation</p>
                    </div>
                    <span class="live @(!connected ? "offline" : "")"><span class="online-dot"></span> @(connected ? "Connected" : "Offline")</span>
                </div>
                <div class="messages">
                    <div class="empty-chat">
                        <span class="empty-icon" aria-hidden="true">✳</span>
                        <h3>Start a direct message</h3>
                        <p>Choose someone to start a conversation, even if they are offline.</p>
                    </div>
                </div>
            }
            else
            {
            <div class="chat-heading">
                <div>
                    <div class="heading-title">
                        <span class="heading-icon" aria-hidden="true">@(selectedUserId is null ? "#" : "✦")</span>
                        <div>
                            <h2>@(selectedUserName ?? "Room")</h2>
                            <p class="heading-subtitle">@(selectedUserId is null ? "The shared space for everyone" : "Direct message")</p>
                        </div>
                    </div>
                </div>
                <span class="live @(!connected ? "offline" : "")"><span class="online-dot"></span> @(connected ? "Connected" : "Offline")</span>
            </div>
            <div class="messages" role="log" aria-live="polite">
                @if (messages.Count == 0)
                {
                    <div class="empty-chat">
                        <span class="empty-icon" aria-hidden="true">✳</span>
                        <h3>A fresh start</h3>
                        <p>Good conversations begin with a hello.<br />Send the first message to get things going.</p>
                    </div>
                }
                @foreach (var message in messages)
                {
                    <article class="message @(message.SenderId == user.Id ? "own" : "")">
                        <div class="message-avatar-wrap">
                            @if (message.SenderPicture is not null)
                            {
                                <img class="message-avatar" src="@PictureUrl(message.SenderPicture)" alt="" />
                            }
                            else
                            {
                                <span class="message-avatar">@Initial(message.SenderName)</span>
                            }
                        </div>
                        <div class="message-content">
                            <div class="message-meta">
                                <strong>@message.SenderName</strong>
                                <time datetime="@message.SentAt.ToString("O")">@message.SentAt.ToLocalTime().ToString("HH:mm")</time>
                            </div>
                            <p>@message.Text</p>
                        </div>
                    </article>
                }
            </div>
            <form class="composer" @onsubmit="SendAsync" @onsubmit:preventDefault>
                <label class="sr-only" for="message">Message</label>
                <input id="message" maxlength="@ChatLimits.MaximumMessageLength" @bind="text"
                       @bind:event="oninput" placeholder="@(selectedUserId is null ? "Message #Room..." : $"Message {selectedUserName}...")" autocomplete="off" disabled="@(!connected)" />
                <button type="submit" disabled="@(!connected)" aria-label="Send message"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m3 11 18-8-7 18-3-7-8-3Zm8 3 10-11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            </form>
            }
        </section>
    </div>
}
else if (error is null)
{
    <p class="notice" role="status">Connecting to chat…</p>
}

@if (error is not null)
{
    <div class="connection-error @(user is null ? "initial-error" : "")" role="alert">
        <p>@error</p>
        @if (connection?.State == HubConnectionState.Disconnected)
        {
            <button type="button" @onclick="ConnectAsync">Reconnect</button>
        }
    </div>
}
@if (pushStatus is not null)
{
    <div class="connection-error" role="status"><p>@pushStatus</p></div>
}
</div>

@code {
    [Parameter] public string LogoutToken { get; set; } = "";
    [Parameter] public string? SenderId { get; set; }
    private HubConnection? connection;
    private ChatUser? user;
    private IReadOnlyList<ChatContact> users = [];
    private IReadOnlyList<ChatMessage> messages = [];
    private string? selectedUserId;
    private string? selectedUserName;
    private string? lastDirectUserId;
    private string? lastDirectUserName;
    private bool showDirectMessages;
    private readonly Dictionary<string, string> drafts = [];
    private string text = "";
    private string? error;
    private bool connected;
    private bool disposed;
    private int refreshVersion;
    private bool editingProfile;
    private bool savingProfile;
    private string profileName = "";
    private string? profileError;
    private byte[]? profileImage;
    private bool pictureSelectionInvalid;
    private bool enablingPush;
    private string? pushStatus;

    private async Task EnablePushAsync()
    {
        enablingPush = true;
        try
        {
            var result = await JS.InvokeAsync<string>("pefiPush.subscribe", LogoutToken, true);
            pushStatus = result == "subscribed" ? "Notifications enabled on this device." : result;
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not enable push notifications.");
            pushStatus = "Could not enable notifications. Check browser permissions and try again.";
        }
        finally { enablingPush = false; }
    }

    private void OpenProfile()
    {
        profileName = user?.Username ?? "";
        profileImage = null;
        pictureSelectionInvalid = false;
        profileError = null;
        editingProfile = true;
    }

    private void CloseProfile() => editingProfile = false;

    private async Task SelectPictureAsync(InputFileChangeEventArgs args)
    {
        profileImage = null;
        pictureSelectionInvalid = false;
        profileError = null;
        if (args.File.Size > ChatLimits.MaximumPictureBytes)
        {
            profileError = "Pictures must be 512 KB or smaller.";
            pictureSelectionInvalid = true;
            return;
        }
        try
        {
            await using var stream = args.File.OpenReadStream(ChatLimits.MaximumPictureBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            profileImage = buffer.ToArray();
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not read the selected profile picture.");
            profileError = "Could not read the picture. Please choose it again.";
            pictureSelectionInvalid = true;
        }
    }

    private async Task SaveProfileAsync()
    {
        if (connection is null || !connected || savingProfile || pictureSelectionInvalid) return;
        savingProfile = true;
        try
        {
            profileError = await connection.InvokeAsync<string?>("UpdateProfile", profileName, profileImage);
            if (profileError is null)
            {
                editingProfile = false;
                await RefreshAsync();
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not update profile.");
            profileError = "Could not update your profile. Please try again.";
        }
        finally { savingProfile = false; }
    }

    private static string PictureUrl(string picture) => $"/profile-pictures/{picture}";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(SenderId))
        {
            showDirectMessages = true;
            selectedUserId = SenderId;
            lastDirectUserId = SenderId;
        }
        connection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/chat-hub"))
            .WithAutomaticReconnect()
            .Build();
        connection.On("Changed", () => { _ = InvokeAsync(RefreshAsync); });
        connection.Reconnecting += exception => InvokeAsync(() =>
        {
            Logger.LogWarning(exception, "Chat connection lost; reconnecting.");
            connected = false;
            error = "Connection lost. Trying to reconnect…";
            StateHasChanged();
        });
        connection.Reconnected += _ => InvokeAsync(async () =>
        {
            connected = true;
            error = null;
            await RefreshAsync();
        });
        connection.Closed += exception => InvokeAsync(() =>
        {
            connected = false;
            error = "Chat is disconnected. Reconnect or refresh the page.";
            if (exception is not null) Logger.LogWarning(exception, "Chat connection closed.");
            StateHasChanged();
        });
        await ConnectAsync();
        try
        {
            await JS.InvokeAsync<string>("pefiPush.subscribe", LogoutToken, false);
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not refresh push subscription.");
            pushStatus = "Could not refresh notifications on this device. Try enabling notifications again.";
        }
    }

    private async Task ConnectAsync()
    {
        if (connection is null || connection.State != HubConnectionState.Disconnected) return;
        try
        {
            error = null;
            await connection.StartAsync();
            connected = true;
            await RefreshAsync();
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not connect to chat.");
            connected = false;
            error = "Could not connect to chat. Check your connection or sign in again.";
        }
    }

    private async Task RefreshAsync()
    {
        if (!connected || connection is null || disposed) return;
        var version = ++refreshVersion;
        var recipient = selectedUserId;
        try
        {
            var snapshot = await connection.InvokeAsync<ChatSnapshot>("GetSnapshot", recipient);
            if (version != refreshVersion || disposed) return;
            user = snapshot.User;
            users = snapshot.Users;
            messages = snapshot.Messages;
            if (selectedUserId is not null && users.FirstOrDefault(person => person.Id == selectedUserId) is { } selected)
            {
                selectedUserName = selected.Name;
                lastDirectUserName = selected.Name;
            }
            StateHasChanged();
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not refresh chat.");
            if (!disposed)
            {
                error = "Could not refresh chat. Please reconnect or refresh the page.";
                StateHasChanged();
            }
        }
    }

    private async Task SelectUserAsync(string? id, string? name)
    {
        var oldKey = ConversationDraftKey();
        if (oldKey is not null) drafts[oldKey] = text;
        selectedUserId = id;
        selectedUserName = name;
        if (showDirectMessages && id is not null)
        {
            lastDirectUserId = id;
            lastDirectUserName = name;
        }
        var newKey = ConversationDraftKey();
        text = newKey is not null && drafts.TryGetValue(newKey, out var draft) ? draft : "";
        messages = [];
        error = null;
        refreshVersion++;
        await RefreshAsync();
    }

    private async Task SelectTabAsync(bool directMessages)
    {
        if (showDirectMessages == directMessages) return;
        var oldKey = ConversationDraftKey();
        if (oldKey is not null) drafts[oldKey] = text;
        showDirectMessages = directMessages;
        selectedUserId = directMessages ? lastDirectUserId : null;
        selectedUserName = directMessages ? lastDirectUserName : null;
        var newKey = ConversationDraftKey();
        text = newKey is not null && drafts.TryGetValue(newKey, out var draft) ? draft : "";
        messages = [];
        error = null;
        refreshVersion++;
        await RefreshAsync();
    }

    private string? ConversationDraftKey() =>
        showDirectMessages ? selectedUserId : "shared";

    private async Task SendAsync()
    {
        if (!connected || connection is null || (showDirectMessages && selectedUserId is null)) return;
        var message = text;
        var draftKey = ConversationDraftKey();
        var recipient = selectedUserId;
        try
        {
            var result = await connection.InvokeAsync<string?>("SendMessage", recipient, message);
            if (result is null && draftKey is not null)
            {
                if (drafts.TryGetValue(draftKey, out var savedDraft) && savedDraft == message)
                    drafts.Remove(draftKey);
                if (ConversationDraftKey() == draftKey && text == message) text = "";
            }
            if (result is not null && ConversationDraftKey() != draftKey)
                error = $"Could not send the previous message: {result}";
            else if (ConversationDraftKey() == draftKey)
                error = result;
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not send chat message.");
            error = "Could not send the message. Please try again.";
        }
    }

    private static string Initial(string name) => name.Trim()[..1].ToUpperInvariant();

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (connection is not null) await connection.DisposeAsync();
    }
}
